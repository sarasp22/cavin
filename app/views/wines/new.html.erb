<div class="wine-form-container">
  <div class="wine-form-card">
    <div class="wine-form-header">
      <div class="wine-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 2h8l2 10-4 10-4-10z"/>
          <ellipse cx="12" cy="2" rx="4" ry="1"/>
        </svg>
      </div>
      <h1 class="wine-form-title">Ajouter un Vin</h1>
      <p class="wine-form-subtitle">Ajoutez une nouvelle bouteille à <%= @storage.name %></p>
    </div>

    <%= form_with model: [@storage, @wine], local: true, class: "wine-form", id: "wine-form" do |f| %>
      <% if current_user.wine_templates.any? %>
        <div class="wine-form-group">
          <label class="wine-form-label">Sélectionner depuis ma bibliothèque</label>
          <select class="wine-form-input" id="wine-template-select" onchange="fillFromTemplate()">
            <option value="">-- Choisir un vin sauvegardé --</option>
            <% current_user.wine_templates.each do |template| %>
              <option value="<%= template.id %>"
                      data-name="<%= template.name %>"
                      data-type="<%= template.wine_type %>"
                      data-region="<%= template.region %>"
                      data-price="<%= template.price %>">
                <%= template.name %> (<%= template.wine_type %> - <%= template.region %>)
              </option>
            <% end %>
          </select>
          <p class="form-hint">Ou remplissez manuellement ci-dessous</p>
        </div>
      <% end %>

      <div class="wine-form-group">
        <%= f.label :name, "Nom du Vin", class: "wine-form-label" %>
        <%= f.text_field :name, placeholder: "Ex: Château Margaux 2015", class: "wine-form-input", required: true, id: "wine-name" %>
      </div>

      <div class="wine-form-group">
        <label class="wine-form-label">Type de Vin</label>
        <div class="wine-type-buttons">
          <% ["Rouge", "Blanc", "Rosé", "Champagne", "Pétillant", "Prosecco"].each_with_index do |type, idx| %>
            <label class="wine-type-option">
              <input type="radio" name="wine[wine_type]" value="<%= type %>" class="wine-type-radio" <%= idx == 0 ? "checked" : "" %> required>
              <span class="wine-type-label <%= type.downcase %>"><%= type %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="form-row">
        <div class="wine-form-group">
          <%= f.label :region, "Région", class: "wine-form-label" %>
          <%= f.text_field :region, id: "wine_region", placeholder: "Ex: Bordeaux, Toscane...", class: "wine-form-input", required: true %>
        </div>

        <div class="wine-form-group">
          <%= f.label :price, "Prix (€)", class: "wine-form-label" %>
          <div class="input-with-currency">
            <%= f.number_field :price, id: "wine_price", step: 0.01, min: 0, placeholder: "0.00", class: "wine-form-input price-input", required: true %>
            <span class="currency-symbol">€</span>
          </div>
        </div>
      </div>

      <div class="wine-form-group">
        <%= f.label :size, "Format de la bouteille", class: "wine-form-label" %>
        <%= f.select :size, ["75cl", "37.5cl", "1.5L (Magnum)", "3L (Jéroboam)", "6L (Mathusalem)"], { selected: (@wine.size.presence || "75cl") }, { class: "wine-form-input", id: "wine_size", required: true } %>
      </div>

      <%
        pre_row = params[:row].present? ? params[:row].to_i : @wine.row_position
        pre_col = params[:col].present? ? params[:col].to_i : @wine.col_position
        pre_pos = (pre_row.present? && pre_col.present?) ? "#{pre_row}-#{pre_col}" : ""
      %>

      <div class="wine-form-section">
        <h3 class="section-title">Positions dans le Stockage</h3>
        <p class="section-explanation" style="font-size: 0.85rem; color: #6b6b6b; margin-bottom: 10px; font-style: italic;">
          Sélectionnez un ou plusieurs emplacements ci-dessous.
        </p>

        <input type="hidden" name="selected_positions" value="<%= pre_pos %>" id="selected-positions-input">

        <div class="position-preview">
          <p class="preview-label">Sélectionnez les emplacements (<span id="count-display" style="font-weight: bold; color: #4caf50;"><%= pre_pos.present? ? 1 : 0 %></span> bouteilles)</p>
          <div class="preview-grid" id="position-preview" style="grid-template-columns: repeat(<%= @storage.cols %>, minmax(0, 1fr)); max-width: <%= @storage.cols * 48 %>px;">
            <% (1..@storage.rows).each do |row| %>
              <% (1..@storage.cols).each do |col| %>
                <% is_occupied = (@occupied_positions || []).include?([row, col]) %>
                <% is_preselected = !is_occupied && pre_row == row && pre_col == col %>
                <div class="preview-slot <%= 'occupied' if is_occupied %> <%= 'selected' if is_preselected %>"
                     data-row="<%= row %>"
                     data-col="<%= col %>"
                     onclick="togglePosition(this, <%= row %>, <%= col %>)">
                  <% if is_occupied %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 2h8l2 10-4 10-4-10z"/>
                      <ellipse cx="12" cy="2" rx="4" ry="1"/>
                    </svg>
                  <% else %>
                    <span class="slot-label">R<%= row %>C<%= col %></span>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="wine-form-actions wine-edit-actions">
        <%= link_to "Annuler", storage_path(@storage), class: "btn-cancel" %>
        <%= f.submit "Ajouter le Vin", class: "btn-submit-wine" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  let selectedPositions = [
    <% if pre_row.present? && pre_col.present? %>
      { row: <%= pre_row %>, col: <%= pre_col %> }
    <% end %>
  ];

  function togglePosition(element, row, col) {
    if (element.classList.contains('occupied')) return;

    const posIndex = selectedPositions.findIndex(function(p) { return p.row === row && p.col === col; });

    if (posIndex > -1) {
      selectedPositions.splice(posIndex, 1);
      element.classList.remove('selected');
    } else {
      selectedPositions.push({ row: row, col: col });
      element.classList.add('selected');
    }
    updateHiddenInput();
  }

  function updateHiddenInput() {
    const input = document.getElementById('selected-positions-input');
    const countDisplay = document.getElementById('count-display');

    const posString = selectedPositions.map(function(p) { return p.row + '-' + p.col; }).join(',');

    if (input) input.value = posString;
    if (countDisplay) countDisplay.textContent = selectedPositions.length;
  }

  function fillFromTemplate() {
    const select = document.getElementById('wine-template-select');
    if (!select) return;
    const option = select.options[select.selectedIndex];
    if (option && option.value) {
      document.getElementById('wine-name').value = option.dataset.name;
      document.getElementById('wine_region').value = option.dataset.region;
      document.getElementById('wine_price').value = option.dataset.price;
      const type = option.dataset.type;
      const radio = document.querySelector('input[type="radio"][value="' + type + '"]');
      if (radio) radio.checked = true;
    }
  }
</script>
