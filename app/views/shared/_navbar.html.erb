  const CAVIN_PLACEHOLDERS = {
    it: {
      "Ex: Ce soir je prépare un filet de bœuf aux morilles pour un dîner romantique...": "Es: Stasera preparo un filetto di manzo ai porcini per una cena romantica...",
      "Ex: Ma Cave Principale": "Es: La mia Cantina Principale",
      "Ex: Ma Cave Privée": "Es: La mia Cantina Privata",
      "Ex: Château Margaux 2015": "Es: Château Margaux 2015",
      "Ex: Bordeaux, Bourgogne, Toscane...": "Es: Bordeaux, Borgogna, Toscana...",
      "Ex: Arômes de fruits rouges...": "Es: Aromi di frutti rossi, tannini setosi..."
    },
    en: {
      "Ex: Ce soir je prépare un filet de bœuf aux morilles pour un dîner romantique...": "Ex: Tonight I'm cooking beef tenderloin with morels for a romantic dinner...",
      "Ex: Ma Cave Principale": "Ex: My Main Cellar",
      "Ex: Ma Cave Privée": "Ex: My Private Cellar",
      "Ex: Château Margaux 2015": "Ex: Château Margaux 2015",
      "Ex: Bordeaux, Bourgogne, Toscane...": "Ex: Bordeaux, Burgundy, Tuscany...",
      "Ex: Arômes de fruits rouges...": "Ex: Red fruit aromas, silky tannins..."
    }
  };

  function getCavinLang() {
    return localStorage.getItem('cavin_lang') || 'fr';
  }

  function translateDynamicText(orig, lang) {
    if (lang === 'fr') return orig;
    const dict = CAVIN_TRANSLATIONS[lang] || {};
    if (dict[orig]) return dict[orig];

    let res = orig;
    if (lang === 'it') {
      res = res.replace(/Pour les vrais conn?aisseurs,\s*chaque bouteille a une histoire\.?/i, 'Per i veri intenditori, ogni bottiglia racconta una storia.');
      res = res.replace(/^(\d+)\s+bouteilles\s+ce\s+jour$/i, '$1 bottiglie in questo giorno');
      res = res.replace(/^(\d+)\s+Bouteilles$/i, '$1 Bottiglie');
      res = res.replace(/•\s*(\d+)\s+bouteilles/i, '• $1 bottiglie');
      res = res.replace(/·\s*(\d+)\s+bout\./i, '· $1 bott.');
      res = res.replace(/^Dites-moi ce que vous mangez ou quelle est l'occasion, et je choisirai la bouteille idéale parmi les$/i, 'Dimmi cosa mangi o qual è l\'occasione, e sceglierò la bottiglia ideale tra le');
      res = res.replace(/^bouteilles$/i, 'bottiglie');
      res = res.replace(/^disponibles dans vos caves\.$/i, 'disponibili nelle tue cantine.');
      res = res.replace(/^Ajoutez une nouvelle bouteille à\s+(.+)$/i, 'Aggiungi una nuova bottiglia a $1');
      res = res.replace(/^Consommé le\s+(.+)$/i, 'Consumato il $1');
      res = res.replace(/^#(\d+)\s+Choix du Sommelier$/i, '#$1 Scelta del Sommelier');
      res = res.replace(/—\s*Rangée\s+(\d+),\s*Colonne\s+(\d+)/i, '— Riga $1, Colonna $2');
      res = res.replace(/^Sélectionnez les emplacements\s*\(/i, 'Seleziona le posizioni (');
      res = res.replace(/\s*bouteilles\)$/i, ' bottiglie)');
    } else if (lang === 'en') {
      res = res.replace(/Pour les vrais conn?aisseurs,\s*chaque bouteille a une histoire\.?/i, 'For true wine lovers, every bottle tells a story.');
      res = res.replace(/\bconn?aisseurs\b/gi, 'wine lovers');
      res = res.replace(/^(\d+)\s+bouteilles\s+ce\s+jour$/i, '$1 bottles on this day');
      res = res.replace(/^(\d+)\s+Bouteilles$/i, '$1 Bottles');
      res = res.replace(/•\s*(\d+)\s+bouteilles/i, '• $1 bottles');
      res = res.replace(/·\s*(\d+)\s+bout\./i, '· $1 bot.');
      res = res.replace(/^Dites-moi ce que vous mangez ou quelle est l'occasion, et je choisirai la bouteille idéale parmi les$/i, 'Tell me what you are eating or the occasion, and I will pick the ideal bottle among the');
      res = res.replace(/^bouteilles$/i, 'bottles');
      res = res.replace(/^disponibles dans vos caves\.$/i, 'available in your cellars.');
      res = res.replace(/^Ajoutez une nouvelle bouteille à\s+(.+)$/i, 'Add a new bottle to $1');
      res = res.replace(/^Consommé le\s+(.+)$/i, 'Consumed on $1');
      res = res.replace(/^#(\d+)\s+Choix du Sommelier$/i, '#$1 Sommelier\'s Pick');
      res = res.replace(/—\s*Rangée\s+(\d+),\s*Colonne\s+(\d+)/i, '— Row $1, Column $2');
      res = res.replace(/^Sélectionnez les emplacements\s*\(/i, 'Select slots (');
      res = res.replace(/\s*bouteilles\)$/i, ' bottles)');
    }
    return res;
  }

  function applyCavinLanguage(lang) {
    document.documentElement.lang = lang;
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.lang === lang);
    });

    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null);
    const textNodes = [];
    while (walker.nextNode()) {
      const node = walker.currentNode;
      const parentTag = node.parentElement ? node.parentElement.tagName : '';
      if (parentTag === 'SCRIPT' || parentTag === 'STYLE') continue;
      textNodes.push(node);
    }

    textNodes.forEach(node => {
      const raw = node.nodeValue || '';
      const trimmed = raw.trim();
      if (!trimmed) return;
      if (!node.__cavinOrig) {
        node.__cavinOrig = trimmed.replace(/\s+/g, ' ');
      }
      const translated = translateDynamicText(node.__cavinOrig, lang);
      const lead = raw.match(/^\s*/)[0];
      const trail = raw.match(/\s*$/)[0];
      node.nodeValue = lead + translated + trail;
    });

    document.querySelectorAll('input[type="submit"]').forEach(el => {
      if (!el.dataset.origValue) {
        el.dataset.origValue = (el.value || '').trim();
      }
      const origV = el.dataset.origValue;
      if (origV) {
        el.value = translateDynamicText(origV, lang);
      }
    });

    document.querySelectorAll('input[placeholder], textarea[placeholder]').forEach(el => {
      if (!el.dataset.origPlaceholder) {
        el.dataset.origPlaceholder = el.getAttribute('placeholder');
      }
      const origP = el.dataset.origPlaceholder;
      if (lang === 'fr') {
        el.setAttribute('placeholder', origP);
      } else {
        const pMap = CAVIN_PLACEHOLDERS[lang] || {};
        if (pMap[origP]) el.setAttribute('placeholder', pMap[origP]);
      }
    });
  }

  function setCavinLang(lang) {
    localStorage.setItem('cavin_lang', lang);
    document.cookie = 'cavin_locale=' + lang + ';path=/;max-age=31536000';
    applyCavinLanguage(lang);
  }

  function initCavinI18n() {
    applyCavinLanguage(getCavinLang());
    const observer = new MutationObserver(() => {
      const current = getCavinLang();
      if (current !== 'fr') applyCavinLanguage(current);
    });
    const resultsEl = document.getElementById('sommelier-results');
    if (resultsEl) {
      observer.observe(resultsEl, { childList: true, subtree: true });
    }
  }

  document.addEventListener('DOMContentLoaded', initCavinI18n);
  document.addEventListener('turbo:load', initCavinI18n);
</script>
