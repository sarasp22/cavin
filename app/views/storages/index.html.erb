<div class="storages-container">
  <div class="storages-header">
    <h1 class="storages-title">Mes Stockages</h1>
    <div class="storages-header-actions">
      <%= link_to sommelier_path, class: "btn-sommelier-action" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3Z"/>
        </svg>
        <span>Quel vin ouvrir ? (Sommelier IA)</span>
      <% end %>
      <%= link_to new_storage_path, class: "btn-add-storage" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Nouveau Stockage</span>
      <% end %>
    </div>
  </div>

  <% if @storages.any? %>
    <%
      all_active_wines = @storages.flat_map { |st| st.wines.where(consumed_at: nil).map { |w| [w, st] } }
      total_bottles_count = all_active_wines.size
      total_cellar_value = all_active_wines.sum { |(w, _st)| w.price.to_f }

      raw_categories = [
        { key: "all", label: "Tous les vins" },
        { key: "rouge", label: "Rouge" },
        { key: "blanc", label: "Blanc" },
        { key: "rosé", label: "Rosé" },
        { key: "champagne", label: "Champagne" },
        { key: "pétillant", label: "Pétillant" },
        { key: "prosecco", label: "Prosecco" }
      ]

      categories = raw_categories.map do |cat|
        matching = if cat[:key] == "all"
                     all_active_wines
                   else
                     all_active_wines.select do |(w, _st)|
                       wt = w.wine_type.to_s.downcase.strip
                       norm = if ["rouge", "rosso", "red"].include?(wt)
                                "rouge"
                              elsif ["blanc", "bianco", "white"].include?(wt)
                                "blanc"
                              elsif ["rosé", "rose", "rosato"].include?(wt)
                                "rosé"
                              elsif wt == "champagne"
                                "champagne"
                              elsif ["pétillant", "petillant", "frizzante", "sparkling"].include?(wt)
                                "pétillant"
                              elsif wt == "prosecco"
                                "prosecco"
                              else
                                "rouge"
                              end
                       norm == cat[:key]
                     end
                   end
        {
          key: cat[:key],
          label: cat[:label],
          count: matching.size,
          val: matching.sum { |(w, _st)| w.price.to_f }
        }
      end
    %>

    <div class="storages-grid">
      <% @storages.each do |storage| %>
        <div class="storage-card">
          <%= link_to storage_path(storage), class: "storage-link" do %>
            <div class="storage-image">
              <%
                photo_file = if storage.photo_url.present?
                               storage.photo_url
                             else
                               case storage.category
                               when "Cave" then "cave.jpg"
                               when "Vinothèque salon" then "vinotheque_salon.png"
                               when "Meuble cuisine" then "meuble_cuisine.jpg"
                               when "Vinothèque cuisine" then "vinotheque_cuisine.png"
                               when "Frigo" then "frigo.png"
                               else "cave.jpg"
                               end
                             end
              %>
              <%= image_tag photo_file, alt: storage.name, class: "storage-photo" %>
              <div class="storage-overlay">
                <h3 class="storage-name"><%= storage.name %></h3>
                <p class="storage-bottles">
                  <%= storage.wines.where(consumed_at: nil).count %> Bouteilles
                </p>
              </div>
            </div>
            <div class="storage-footer">
              <span class="storage-action">VOIR DÉTAILS</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="cellar-summary-bar">
      <button type="button" class="cellar-summary-pill" onclick="openCellarDrawer('all')">
        <span class="cellar-summary-dot"></span>
        <span class="cellar-summary-count"><strong><%= total_bottles_count %></strong> <span>Bouteilles</span></span>
        <span class="cellar-summary-sep">|</span>
        <span class="cellar-summary-val"><strong><%= number_with_precision(total_cellar_value, precision: 2, separator: ",") %> €</strong></span>
      </button>

      <div class="cellar-dropdown-control">
        <select id="cellar-quick-select" class="cellar-category-select" aria-label="Filtrer par catégorie" onchange="if(this.value) { openCellarDrawer(this.value); }">
          <option value="" selected disabled>Explorer par catégorie...</option>
          <% categories.each do |cat| %>
            <option value="<%= cat[:key] %>">
              <%= cat[:label] %> (<%= cat[:count] %>) — <%= number_with_precision(cat[:val], precision: 2, separator: ",") %> €
            </option>
          <% end %>
        </select>
        <button type="button" class="btn-open-drawer" onclick="openCellarDrawer('all')">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          <span>Inventaire</span>
        </button>
      </div>
    </div>

    <div class="cellar-drawer-backdrop" id="cellar-drawer-backdrop" onclick="if(event.target === this) closeCellarDrawer()">
      <div class="cellar-drawer-panel" role="dialog" aria-modal="true">
        <div class="cellar-drawer-header">
          <div>
            <h3 class="cellar-drawer-title" id="cellar-drawer-title">
              <span>Tous les vins</span> (<%= total_bottles_count %>)
            </h3>
            <p class="cellar-drawer-subtitle" id="cellar-drawer-subtitle">
              <%= total_bottles_count %> Bouteilles • <%= number_with_precision(total_cellar_value, precision: 2, separator: ",") %> €
            </p>
          </div>
          <button type="button" class="cellar-drawer-close" onclick="closeCellarDrawer()" aria-label="Fermer">
            ✕
          </button>
        </div>

        <div class="cellar-drawer-filter-bar">
          <select id="drawer-category-select" class="cellar-drawer-select" onchange="filterDrawerByCategory(this.value)">
            <% categories.each do |cat| %>
              <option value="<%= cat[:key] %>"
                      data-label="<%= cat[:label] %>"
                      data-count="<%= cat[:count] %>"
                      data-val="<%= number_with_precision(cat[:val], precision: 2, separator: ",") %>">
                <%= cat[:label] %> (<%= cat[:count] %>) — <%= number_with_precision(cat[:val], precision: 2, separator: ",") %> €
              </option>
            <% end %>
          </select>

          <div class="cellar-drawer-chips">
            <% categories.each_with_index do |cat, idx| %>
              <button type="button"
                      class="cellar-drawer-chip <%= 'active' if idx == 0 %>"
                      data-chip-cat="<%= cat[:key] %>"
                      onclick="filterDrawerByCategory('<%= cat[:key] %>')">
                <span><%= cat[:label] %></span>
                <strong><%= cat[:count] %></strong>
              </button>
            <% end %>
          </div>
        </div>

        <div class="cellar-drawer-list" id="cellar-drawer-list">
          <% all_active_wines.each do |(wine, storage)| %>
            <%
              wt = wine.wine_type.to_s.downcase.strip
              cat_key = if ["rouge", "rosso", "red"].include?(wt)
                          "rouge"
                        elsif ["blanc", "bianco", "white"].include?(wt)
                          "blanc"
                        elsif ["rosé", "rose", "rosato"].include?(wt)
                          "rosé"
                        elsif wt == "champagne"
                          "champagne"
                        elsif ["pétillant", "petillant", "frizzante", "sparkling"].include?(wt)
                          "pétillant"
                        elsif wt == "prosecco"
                          "prosecco"
                        else
                          "rouge"
                        end
            %>
            <%= link_to storage_wine_path(storage, wine), class: "cellar-ping-card cat-#{cat_key}", data: { wine_cat: cat_key } do %>
              <div class="cellar-ping-body">
                <div class="cellar-ping-top">
                  <h4 class="cellar-ping-title"><%= wine.name %></h4>
                  <div class="cellar-ping-right">
                    <span class="cellar-ping-tag <%= cat_key %>"><%= wine.wine_type %></span>
                    <span class="cellar-ping-price"><%= number_with_precision(wine.price.to_f, precision: 2, separator: ",") %> €</span>
                  </div>
                </div>
                <div class="cellar-ping-meta">
                  <span class="cellar-ping-storage">
                    📍 <%= storage.name %> (R<%= wine.row_position %>-C<%= wine.col_position %>)
                  </span>
                  <span class="cellar-ping-desc">
                    <%= wine.region %> • <%= wine.respond_to?(:size) && wine.size.present? ? wine.size : "75cl" %>
                  </span>
                </div>
              </div>
            <% end %>
          <% end %>

          <div id="cellar-drawer-empty" class="cellar-drawer-empty" style="display: <%= all_active_wines.empty? ? 'block' : 'none' %>;">
            <p>Aucune bouteille dans cette catégorie</p>
          </div>
        </div>
      </div>
    </div>

    <script>
      function openCellarDrawer(catKey) {
        const backdrop = document.getElementById('cellar-drawer-backdrop');
        if (!backdrop) return;
        backdrop.classList.add('open');
        document.body.style.overflow = 'hidden';
        filterDrawerByCategory(catKey || 'all');
      }

      function closeCellarDrawer() {
        const backdrop = document.getElementById('cellar-drawer-backdrop');
        if (!backdrop) return;
        backdrop.classList.remove('open');
        document.body.style.overflow = '';
        const quickSelect = document.getElementById('cellar-quick-select');
        if (quickSelect) quickSelect.selectedIndex = 0;
      }

      function filterDrawerByCategory(catKey) {
        const drawerSelect = document.getElementById('drawer-category-select');
        if (drawerSelect) {
          drawerSelect.value = catKey;
          const selectedOpt = drawerSelect.options[drawerSelect.selectedIndex];
          if (selectedOpt) {
            const label = selectedOpt.getAttribute('data-label') || 'Inventaire';
            const count = selectedOpt.getAttribute('data-count') || '0';
            const val = selectedOpt.getAttribute('data-val') || '0,00';
            const titleEl = document.getElementById('cellar-drawer-title');
            const subEl = document.getElementById('cellar-drawer-subtitle');
            if (titleEl) titleEl.textContent = label + ' (' + count + ')';
            if (subEl) subEl.textContent = count + ' Bouteilles • ' + val + ' €';
          }
        }

        document.querySelectorAll('.cellar-drawer-chip').forEach(function(chip) {
          chip.classList.toggle('active', chip.getAttribute('data-chip-cat') === catKey);
        });

        let visible = 0;
        document.querySelectorAll('.cellar-ping-card').forEach(function(card) {
          const itemCat = card.getAttribute('data-wine-cat');
          if (catKey === 'all' || itemCat === catKey) {
            card.style.display = 'flex';
            visible++;
          } else {
            card.style.display = 'none';
          }
        });

        const emptyEl = document.getElementById('cellar-drawer-empty');
        if (emptyEl) {
          emptyEl.style.display = visible === 0 ? 'block' : 'none';
        }
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeCellarDrawer();
      });
    </script>
  <% else %>
    <div class="empty-state">
      <h2 class="empty-title">Aucun stockage pour le moment</h2>
      <p class="empty-description">Créez votre premier espace de stockage pour commencer à gérer votre cave à vin</p>
      <%= link_to "Créer mon premier stockage", new_storage_path, class: "btn-add-storage" %>
    </div>
  <% end %>
</div>
