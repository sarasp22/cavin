<div class="storages-container">
  <div class="storages-header">
    <h1 class="storages-title">Mes Stockages</h1>
    <div class="storages-header-actions">
      <%= link_to sommelier_path, class: "btn-sommelier-action" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3Z"/>
        </svg>
        <span>Quel vin ouvrir ? (Sommelier IA)</span>
      <% end %>
      <%= link_to new_storage_path, class: "btn-add-storage" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Nouveau Stockage</span>
      <% end %>
    </div>
  </div>

  <% if @storages.any? %>
    <%
      active_wines = @storages.flat_map { |s| s.wines.where(consumed_at: nil).to_a }
      total_bottles = active_wines.size
      total_value = active_wines.sum { |w| w.price.to_f }

      normalize_cat = lambda do |wt|
        s = wt.to_s.strip.downcase
        case s
        when 'rouge', 'rosso', 'red' then 'rouge'
        when 'blanc', 'bianco', 'white' then 'blanc'
        when 'rosé', 'rose', 'rosato' then 'rosé'
        when 'champagne' then 'champagne'
        when 'pétillant', 'petillant', 'frizzante', 'sparkling' then 'pétillant'
        when 'prosecco' then 'prosecco'
        else 'rouge'
        end
      end

      categories = [
        { key: 'all', label: 'Tous les vins' },
        { key: 'rouge', label: 'Rouge' },
        { key: 'blanc', label: 'Blanc' },
        { key: 'rosé', label: 'Rosé' },
        { key: 'champagne', label: 'Champagne' },
        { key: 'pétillant', label: 'Pétillant' },
        { key: 'prosecco', label: 'Prosecco' }
      ].map do |cat|
        matching = cat[:key] == 'all' ? active_wines : active_wines.select { |w| normalize_cat.call(w.wine_type) == cat[:key] }
        cat.merge(
          count: matching.size,
          val: matching.sum { |w| w.price.to_f }
        )
      end
    %>

    <div class="storages-grid">
      <% @storages.each do |storage| %>
        <% storage_bottles_count = storage.wines.where(consumed_at: nil).count %>
        <% storage_cat = storage.respond_to?(:category) ? storage.category : (storage.respond_to?(:storage_type) ? storage.storage_type : "Cave") %>
        <% photo_asset = case storage_cat
                         when "Cave"
                           "cave.jpg"
                         when "Vinothèque salon"
                           "vinotheque_salon.png"
                         when "Meuble cuisine"
                           "meuble_cuisine.jpg"
                         when "Vinothèque cuisine"
                           "vinotheque_cuisine.png"
                         when "Frigo"
                           if File.exist?(Rails.root.join("app/assets/images/frigo.png"))
                             "frigo.png"
                           elsif File.exist?(Rails.root.join("app/assets/images/frigo.jpg"))
                             "frigo.jpg"
                           else
                             "vinotheque_cuisine.png"
                           end
                         else
                           "cave.jpg"
                         end %>
        <div class="storage-card">
          <%= link_to storage_path(storage), class: "storage-link" do %>
            <div class="storage-image">
              <%= image_tag photo_asset, alt: storage.name, class: "storage-photo" %>
              <div class="storage-overlay">
                <h3 class="storage-name"><%= storage.name %></h3>
                <p class="storage-bottles">
                  <%= storage_bottles_count %> Bouteilles
                </p>
              </div>
            </div>
            <div class="storage-footer">
              <span class="storage-action">VOIR DÉTAILS</span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="cellar-summary-bar">
      <div class="cellar-summary-pill">
        <span class="cellar-summary-dot"></span>
        <span class="cellar-summary-count"><strong><%= total_bottles %></strong> <span>Bouteilles</span></span>
        <span class="cellar-summary-sep">|</span>
        <span class="cellar-summary-val"><strong><%= number_with_precision(total_value, precision: 2, separator: ",") %> €</strong></span>
      </div>

      <button type="button"
              class="cellar-drawer-chip cellar-open-pill"
              onclick="openCellarDrawer('all')">
        <span>Tous les vins</span>
        <strong><%= total_bottles %></strong>
      </button>
    </div>

    <div class="cellar-drawer-backdrop" id="cellar-drawer-backdrop" onclick="if(event.target === this) closeCellarDrawer()">
      <div class="cellar-drawer-panel" role="dialog" aria-modal="true">
        <div class="cellar-drawer-header">
          <div>
            <h3 class="cellar-drawer-title" id="cellar-drawer-title">
              <span>Tous les vins</span> (<%= total_bottles %>)
            </h3>
            <p class="cellar-drawer-subtitle" id="cellar-drawer-subtitle">
              <%= total_bottles %> Bouteilles • <%= number_with_precision(total_value, precision: 2, separator: ",") %> €
            </p>
          </div>
          <button type="button" class="cellar-drawer-close" onclick="closeCellarDrawer()" aria-label="Fermer">
            ✕
          </button>
        </div>

        <div class="cellar-drawer-filter-bar">
          <div class="cellar-drawer-chips">
            <% categories.each_with_index do |cat, idx| %>
              <button type="button"
                      class="cellar-drawer-chip <%= idx == 0 ? 'active' : '' %>"
                      data-chip-cat="<%= cat[:key] %>"
                      data-label="<%= cat[:label] %>"
                      data-count="<%= cat[:count] %>"
                      data-val="<%= number_with_precision(cat[:val], precision: 2, separator: ",") %>"
                      onclick="filterDrawerByCategory('<%= cat[:key] %>')">
                <span><%= cat[:label] %></span>
                <strong><%= cat[:count] %></strong>
              </button>
            <% end %>
          </div>
        </div>

        <div class="cellar-drawer-list" id="cellar-drawer-list">
          <% @storages.each do |storage| %>
            <% storage.wines.where(consumed_at: nil).each do |wine| %>
              <% cat_key = normalize_cat.call(wine.wine_type) %>
              <% wine_size = (wine.respond_to?(:size) && wine.size.present?) ? wine.size : "75cl" %>
              <%= link_to storage_wine_path(storage, wine),
                          class: "cellar-ping-card cat-#{cat_key}",
                          data: { wine_cat: cat_key } do %>
                <div class="cellar-ping-body">
                  <div class="cellar-ping-top">
                    <h4 class="cellar-ping-title"><%= wine.name %></h4>
                    <div class="cellar-ping-right">
                      <span class="cellar-ping-tag <%= cat_key %>"><%= wine.wine_type %></span>
                      <span class="cellar-ping-price"><%= number_with_precision(wine.price || 0, precision: 2, separator: ",") %> €</span>
                    </div>
                  </div>
                  <div class="cellar-ping-meta">
                    <span class="cellar-ping-storage">
                      📍 <%= storage.name %> (R<%= wine.row_position %>-C<%= wine.col_position %>)
                    </span>
                    <span class="cellar-ping-desc">
                      <%= wine.region %> • <%= wine_size %>
                    </span>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>

          <div id="cellar-drawer-empty" class="cellar-drawer-empty" style="display: <%= active_wines.empty? ? 'block' : 'none' %>;">
            <p>Aucune bouteille dans cette catégorie</p>
          </div>
        </div>
      </div>
    </div>

    <script>
      function openCellarDrawer(catKey) {
        const backdrop = document.getElementById('cellar-drawer-backdrop');
        if (!backdrop) return;
        backdrop.classList.add('open');
        document.body.style.overflow = 'hidden';
        filterDrawerByCategory(catKey || 'all');
      }

      function closeCellarDrawer() {
        const backdrop = document.getElementById('cellar-drawer-backdrop');
        if (!backdrop) return;
        backdrop.classList.remove('open');
        document.body.style.overflow = '';
        document.querySelectorAll('[data-summary-chip]').forEach(function(chip) {
          chip.classList.remove('active');
        });
      }

      function filterDrawerByCategory(catKey) {
        let activeChip = null;
        document.querySelectorAll('.cellar-drawer-filter-bar .cellar-drawer-chip').forEach(function(chip) {
          const isMatch = chip.getAttribute('data-chip-cat') === catKey;
          chip.classList.toggle('active', isMatch);
          if (isMatch) activeChip = chip;
        });

        document.querySelectorAll('[data-summary-chip]').forEach(function(chip) {
          chip.classList.toggle('active', chip.getAttribute('data-summary-chip') === catKey);
        });

        if (activeChip) {
          const labelSpan = activeChip.querySelector('span');
          const label = labelSpan ? labelSpan.textContent : (activeChip.getAttribute('data-label') || 'Inventaire');
          const count = activeChip.getAttribute('data-count') || '0';
          const val = activeChip.getAttribute('data-val') || '0,00';
          const titleEl = document.getElementById('cellar-drawer-title');
          const subEl = document.getElementById('cellar-drawer-subtitle');
          if (titleEl) titleEl.textContent = label + ' (' + count + ')';
          if (subEl) subEl.textContent = count + ' Bouteilles • ' + val + ' €';
        }

        let visible = 0;
        document.querySelectorAll('.cellar-ping-card').forEach(function(card) {
          const itemCat = card.getAttribute('data-wine-cat');
          if (catKey === 'all' || itemCat === catKey) {
            card.style.display = 'flex';
            visible++;
          } else {
            card.style.display = 'none';
          }
        });

        const emptyEl = document.getElementById('cellar-drawer-empty');
        if (emptyEl) {
          emptyEl.style.display = visible === 0 ? 'block' : 'none';
        }
      }

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeCellarDrawer();
      });
    </script>
  <% else %>
    <div class="empty-state">
      <h2 class="empty-title">Aucun stockage pour le moment</h2>
      <p class="empty-description">Créez votre premier espace de stockage pour commencer à gérer votre cave à vin</p>
      <%= link_to "Créer mon premier stockage", new_storage_path, class: "btn-add-storage" %>
    </div>
  <% end %>
</div>
