<div class="storage-form-container">
  <div class="storage-form-card">
    <h1 class="form-main-title">Ajouter Nouveau Stockage</h1>

    <%= form_with model: @storage, local: true, class: "storage-form", id: "storage-form" do |f| %>
      <div class="form-section">
        <label class="form-section-label">Nom du Stockage</label>
        <div class="input-with-icon">
          <%= f.text_field :name, placeholder: "Ex: Ma Cave Principale", class: "form-text-input", required: true %>
          <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </div>
      </div>

      <div class="form-section">
        <label class="form-section-label">Type de Stockage</label>
        <div class="storage-types-grid">
          <% categories = ["Cave", "Vinothèque cuisine", "Vinothèque salon", "Meuble cuisine", "Frigo"] %>
          <% categories.each_with_index do |category, index| %>
            <%
              file_name = case category
                          when "Cave" then "cave.jpg"
                          when "Vinothèque salon" then "vinotheque_salon.png"
                          when "Meuble cuisine" then "meuble_cuisine.jpg"
                          when "Vinothèque cuisine" then "vinotheque_cuisine.png"
                          when "Frigo" then "frigo.png"
                          else "default_storage.jpg"
                          end
            %>
            <div class="storage-type-card" onclick="selectCategory(this, '<%= category %>')">
              <%= f.radio_button :category, category, class: "storage-radio-input", id: "category_#{index}", checked: (index == 0), required: true %>
              <label for="category_<%= index %>" class="storage-type-label">
                <div class="storage-type-image">
                  <%= image_tag file_name, alt: category, class: "category-img" %>
                  <div class="storage-type-overlay">
                    <h3 class="storage-type-name"><%= category %></h3>
                  </div>
                </div>
              </label>
            </div>
          <% end %>
        </div>
      </div>

      <div class="form-section">
        <label class="form-section-label">Dimensions du Stockage</label>

        <div class="dimensions-grid">
          <div class="dimension-control">
            <label class="dimension-label">Colonnes</label>
            <div class="dimension-input-group">
              <button type="button" class="dimension-btn" onclick="changeCols(-1)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
              <%= f.number_field :cols, value: (@storage.cols || 4), min: 1, max: 20, class: "dimension-input", id: "cols-input", onchange: "updateGrid()" %>
              <button type="button" class="dimension-btn" onclick="changeCols(1)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>
          </div>

          <div class="dimension-control">
            <label class="dimension-label">Rangées</label>
            <div class="dimension-input-group">
              <button type="button" class="dimension-btn" onclick="changeRows(-1)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
              <%= f.number_field :rows, value: (@storage.rows || 3), min: 1, max: 20, class: "dimension-input", id: "rows-input", onchange: "updateGrid()" %>
              <button type="button" class="dimension-btn" onclick="changeRows(1)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="grid-preview">
          <p class="preview-label" id="storage-slots-label">Aperçu de la grille</p>
          <div class="grid-preview-container" id="grid-preview"></div>
        </div>
      </div>

      <div class="form-actions storage-form-actions">
        <%= link_to "Annuler", storages_path, class: "btn-secondary" %>
        <%= f.submit "Créer Stockage", class: "btn-submit-storage" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    updateGrid();
  });
  document.addEventListener('turbo:load', function() {
    updateGrid();
  });

  function selectCategory(card, category) {
    document.querySelectorAll('.storage-type-card').forEach(function(c) {
      c.classList.remove('active');
    });
    card.classList.add('active');
    const radio = card.querySelector('input[type="radio"]');
    if (radio) radio.checked = true;
  }

  function changeRows(delta) {
    const input = document.getElementById('rows-input');
    if (!input) return;
    let currentValue = parseInt(input.value, 10) || 3;
    let newValue = currentValue + delta;
    if (newValue >= 1 && newValue <= 20) {
      input.value = newValue;
      updateGrid();
    }
  }

  function changeCols(delta) {
    const input = document.getElementById('cols-input');
    if (!input) return;
    let currentValue = parseInt(input.value, 10) || 4;
    let newValue = currentValue + delta;
    if (newValue >= 1 && newValue <= 20) {
      input.value = newValue;
      updateGrid();
    }
  }

  function updateGrid() {
    const rowsInput = document.getElementById('rows-input');
    const colsInput = document.getElementById('cols-input');
    const gridPreview = document.getElementById('grid-preview');
    const labelEl = document.getElementById('storage-slots-label');
    if (!rowsInput || !colsInput || !gridPreview) return;

    const rows = Math.min(Math.max(1, parseInt(rowsInput.value, 10) || 3), 20);
    const cols = Math.min(Math.max(1, parseInt(colsInput.value, 10) || 4), 20);

    if (labelEl) {
      labelEl.textContent = 'Aperçu de la grille (' + rows + ' × ' + cols + ' = ' + (rows * cols) + ' emplacements)';
    }

    gridPreview.style.gridTemplateColumns = 'repeat(' + cols + ', minmax(0, 1fr))';
    gridPreview.style.maxWidth = (cols * 48) + 'px';
    gridPreview.innerHTML = '';

    const totalSlots = rows * cols;
    for (let i = 0; i < totalSlots; i++) {
      const slot = document.createElement('div');
      slot.className = 'bottle-slot';
      slot.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4a0e0e" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2h4v2.5h-4z" fill="#4a0e0e"/><path d="M10 4.5v5.5c0 0 0 1-1 2s-2 1.5-2 4v6c0 1.1.9 2 2 2h6c1.1 0 2-.9 2-2v-6c0-2.5-1-3-2-4s-1-2-1-2V4.5"/></svg>';
      gridPreview.appendChild(slot);
    }
  }
</script>
